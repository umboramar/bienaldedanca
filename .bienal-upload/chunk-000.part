<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>X Bienal Internacional de Dança do Ceará — De Par em Par</title>
<meta name="description" content="X Bienal Internacional de Dança do Ceará — De Par em Par. De 21 de outubro a 1º de novembro de 2026. Programação gratuita, formações, A Casa Movimenta e informações.">
<meta name="theme-color" content="#000000">
<style>
:root{color-scheme:dark;--orange:#ff5708}*{box-sizing:border-box}html,body{margin:0;padding:0;background:#000;color:white;font-family:Arial,sans-serif}body{min-height:100vh}main{max-width:1920px;margin:auto}#canvas{position:relative}svg.artboard{display:block;width:100%;height:auto}#canvas>svg{display:block;width:100%;height:auto}.raster{position:relative;width:100%;overflow:hidden}.raster>img{display:block;width:100%;height:auto}#loading{padding:18vh 16px;text-align:center;color:#ddd}a[aria-label]>.hotspot{fill:transparent;stroke:transparent;stroke-width:1;cursor:pointer}a[aria-label]:focus-visible>.hotspot{stroke:var(--orange);stroke-width:4}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid var(--orange);outline-offset:3px}dialog{box-sizing:border-box;border:1px solid #333;background:#111;color:white;max-height:85vh;overflow:auto;border-radius:3px;padding:28px;max-width:min(640px,92vw);width:100%;box-shadow:0 12px 55px #000c}dialog::backdrop{background:#000d}dialog h2{font-size:25px;font-weight:400;margin:0 42px 14px 0;text-transform:uppercase;letter-spacing:.025em}dialog p{line-height:1.55;color:#ddd}dialog .close{position:absolute;right:15px;top:12px;width:36px;height:36px;background:none;border:0;color:#fff;font-size:26px}dialog a,dialog .choice{color:#fff;display:block;text-decoration:none;padding:15px 8px;border-bottom:1px solid #363636;font-size:16px;background:transparent;text-align:left;width:100%;border-top:0;border-left:0;border-right:0}dialog a:hover,dialog .choice:hover{color:var(--orange)}dialog input{box-sizing:border-box;width:100%;background:#fff;color:#111;border:0;padding:14px 10px;margin:9px 0 16px;font-size:17px}dialog .hint{font-size:13px;color:#aaa}#alert{display:none;position:fixed;bottom:16px;left:16px;background:#1e1e1e;color:white;padding:12px 18px;z-index:20;max-width:min(490px,95vw);border-left:3px solid var(--orange)}.hit-raster{position:absolute;background:transparent;border:0;cursor:pointer;padding:0;font-size:0;appearance:none}.hit-raster:focus-visible{outline:3px solid var(--orange)}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}

#canvas .catalog-viewport{width:100%;margin:0 auto;background:#fff;color:#111}#canvas .catalog-page{position:relative;display:block;width:100%;padding:0;margin:0;line-height:0;background:#fff}#canvas .catalog-page img{display:block;width:100%;height:auto}#canvas .catalog-page .catalog-ficha-anchor{position:absolute;top:86%;left:0;width:1px;height:1px}#canvas .catalog-page button.hit-raster{z-index:3}
</style></head><body>
<main id="site"><div id="canvas" role="main" aria-live="polite"><p id="loading">Carregando a Bienal…</p></div></main>
<dialog id="dialog" aria-labelledby="modal-title"><button class="close" type="button" aria-label="Fechar painel">×</button><h2 id="modal-title"></h2><div id="modal-body"></div></dialog>
<div id="alert" role="status"></div>
<script id="page-data" type="application/json">{"inicio":"\u003csvg class=\"artboard\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" viewBox=\"0 0 1920 3673.66\" width=\"1920\" height=\"3673.66\" role=\"img\" aria-label=\"Página 1 da Bienal Internacional de Dança do Ceará\">\u003cimage x=\"0\" y=\"0\" width=\"1920\" height=\"3673.66\" preserveAspectRatio=\"none\" xlink:href=\"data:image/webp;base64,