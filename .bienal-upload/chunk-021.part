\">\u003cspan class=\"catalog-ficha-anchor\" id=\"catalog-ficha\" aria-hidden=\"true\">\u003c/span>\u003c/section>\u003c/div>"}</script><script>
'use strict';
const $=(sel,root=document)=>root.querySelector(sel);
const views=JSON.parse($('#page-data').textContent);
const names={'inicio':'Início','a-bienal':'A Bienal','programacao':'Programação','formacoes':'Formações','a-casa-movimenta':'A Casa Movimenta','informacoes':'Informações','catalogo':'Catálogo'};
const aliases={'programacao-fortaleza':'programacao','programacao-interior':'programacao','ficha-tecnica':'informacoes','a-casa':'a-casa-movimenta'};
const external={
 instagram:'https://www.instagram.com/bienaldedanca/',
 youtube:'https://www.youtube.com/@bienalinternacionaldedancadoce',
 facebook:'https://www.facebook.com/bienaldedanca',
 tiktok:'https://www.tiktok.com/@bienaldedanca',
 catalogo:'',bilheteria:'',videocast:'',resenhas:'',imprensa:'https://drive.google.com/drive/folders/1hFytsu1lK3QkKcZUWrH7uzW41BCECvLa'
};
const destinations={catalogo:'Catálogo',bilheteria:'Bilheteria',videocast:'Videocast',resenhas:'Dança em Palavras',imprensa:'Materiais de imprensa'};
const dialog=$('#dialog'),body=$('#modal-body');let current='inicio',token=0;
const make=(tag,attrs={},txt)=>{let e=document.createElement(tag);for(const [k,v]of Object.entries(attrs))e.setAttribute(k,String(v));if(txt!==undefined)e.textContent=txt;return e};
function modal(title){$('#modal-title').textContent=title;body.replaceChildren();if(!dialog.open)dialog.showModal()}
function line(text){const p=make('p',{},text);body.append(p);return p}
function dismiss(){if(dialog.open)dialog.close()}
$('.close').onclick=dismiss;dialog.addEventListener('click',e=>{if(e.target===dialog)dismiss()});
function go(id,anchor=''){dismiss();id=aliases[id]||id;if(!(id in names))id='inicio';const route='#'+id+(anchor?'/'+anchor:'');if(location.hash===route){render()}else location.hash=route}
function openExternal(key){if(key==='catalogo'){go('catalogo');return}const url=external[key];if(url){window.open(url,'_blank','noopener,noreferrer');return}modal(destinations[key]||'Informações');line('O endereço deste material não consta no PDF de referência. A chamada permanece disponível, mas o link precisa ser informado pela organização.');const b=make('button',{class:'choice',type:'button'},'Ver informações e contatos');b.onclick=()=>go('informacoes');body.append(b)}
function items(entries){const nav=make('nav',{'aria-label':'Navegação'});for(const [label,fn] of entries){const b=make('button',{class:'choice',type:'button'},label);b.onclick=fn;nav.append(b)}body.append(nav)}
function menu(){modal('Navegar pela Bienal');items([["Início",()=>go('inicio')],["A Bienal",()=>go('a-bienal')],["Programação",()=>go('programacao')],["Formações",()=>go('formacoes')],["Catálogo",()=>go('catalogo')],["A Casa Movimenta",()=>go('a-casa-movimenta')],["Informações",()=>go('informacoes')]])}
function search(){modal('Buscar na Bienal');const input=make('input',{type:'search',placeholder:'Busque programação, cidade, oficinas…','aria-label':'Buscar no site'});const results=make('div',{'aria-live':'polite'});body.append(input,results);const indexed=[
 ['Catálogo — Espetáculos, formações e ficha técnica','catalogo'],['Catálogo — Ficha técnica','catalogo','ficha'],['A Bienal — História e manifesto','a-bienal'],['Programação gratuita — Fortaleza','programacao'],['Programação — Juazeiro do Norte','programacao','juazeiro'],['Programação — Paracuru','programacao','paracuru'],['Programação — Crato','programacao','crato'],['Programação — Pacatuba','programacao','pacatuba'],['Programação — Canoa Quebrada','programacao','canoa'],['Programação — Baturité','programacao','baturite'],['Programação — Guaramiranga','programacao','guaramiranga'],['Formações — Oficinas','formacoes','oficinas'],['Formações — Seminário','formacoes','seminario'],['Formações — Percursos de criação','formacoes','percursos'],['Formações — Residências artísticas','formacoes','residencias'],['Videocast','formacoes','videocast'],['Dança em Palavras','formacoes','danca'],['A Casa Movimenta','a-casa-movimenta'],['Ficha técnica','informacoes','ficha'],['Contatos','informacoes','contatos'],['Imprensa','informacoes','imprensa']];
 const normalize=s=>s.toLocaleLowerCase('pt-BR').normalize('NFD').replace(/[\u0300-\u036f]/g,'');
 function update(){results.replaceChildren();const q=normalize(input.value.trim());if(!q){lineResult('Digite uma palavra para pesquisar.');return}let count=0;for(const [name,id,anchor] of indexed){if(!normalize(name).includes(q))continue;count++;const b=make('button',{class:'choice',type:'button'},name);b.onclick=()=>go(id,anchor||'');results.append(b)}if(!count)lineResult('Nenhum resultado encontrado.');}
 function lineResult(t){results.append(make('p',{class:'hint'},t))}input.addEventListener('input',update);update();input.focus()}
function spot(svg,x,y,w,h,label,action){const ns='http://www.w3.org/2000/svg';const a=document.createElementNS(ns,'a'),r=document.createElementNS(ns,'rect');a.setAttribute('href','#');a.setAttribute('aria-label',label);a.setAttribute('role','link');Object.entries({x,y,width:w,height:h,class:'hotspot'}).forEach(([k,v])=>r.setAttribute(k,v));a.append(r);a.onclick=e=>{e.preventDefault();action()};svg.append(a)}
function rasterSpot(root,x,y,w,h,label,action){const a=make('button',{class:'hit-raster','aria-label':label,title:label,type:'button'});a.style.left=100*x/1920+'%';a.style.top=100*y/2812+'%';a.style.width=100*w/1920+'%';a.style.height=100*h/2812+'%';a.onclick=action;root.append(a)}
function enhance(root,id){
 if(id==='catalogo'){
   const first=$('.catalog-page',root);
   const add=(x,y,w,h,label,action)=>{const b=make('button',{class:'hit-raster','aria-label':label,title:label,type:'button'});b.style.left=(x/1920*100)+'%';b.style.top=(y/4733*100)+'%';b.style.width=(w/1920*100)+'%';b.style.height=(h/4733*100)+'%';b.onclick=action;first.append(b)};
   [[120,150,'A Bienal',()=>go('a-bienal')],[340,220,'Programação',()=>go('programacao')],[630,165,'Formações',()=>go('formacoes')],[890,160,'Catálogo',()=>go('catalogo')],[1100,270,'A Casa Movimenta',()=>go('a-casa-movimenta')],[1440,205,'Informações',()=>go('informacoes')],[1655,66,'Buscar',search],[1730,95,'Menu',menu]].forEach(([x,w,label,act])=>add(x,42,w,90,label,act));
   return;
 }
 const sv=$('svg',root),raster=$('.raster',root);const add=(x,y,w,h,l,f)=>sv?spot(sv,x,y,w,h,l,f):rasterSpot(raster,x,y,w,h,l,f);
 // A interação acompanha os mesmos pontos do layout: nenhuma barra de navegação sobreposta.
 [[120,150,'A Bienal',()=>go('a-bienal')],[340,220,'Programação',()=>go('programacao')],[630,165,'Formações',()=>go('formacoes')],[890,160,'Catálogo',()=>go('catalogo')],[1100,270,'A Casa Movimenta',()=>go('a-casa-movimenta')],[1440,205,'Informações',()=>go('informacoes')],[1655,66,'Buscar',search],[1730,95,'Menu',menu]].forEach(([x,w,label,act])=>add(x,42,w,90,label,act));
 if(id==='inicio'){
 add(10,1050,1900,160,'Ver programação gratuita',()=>go('programacao'));
 const cards=[[0,1154,'Corpo em movimento',()=>go('formacoes','oficinas')],[960,1154,'Dança em Palavras',()=>go('formacoes','danca')],[0,1515,'Videocast',()=>go('formacoes','videocast')],[960,1515,'Catálogo',()=>go('catalogo')],[0,1875,'A Casa Movimenta',()=>go('a-casa-movimenta')],[960,1875,'Bilheteria e informações',()=>go('informacoes')]];
 for(const [x,y,label,action]of cards)add(x,y,955,360,label,action);
 // Redes sociais nas áreas dos ícones presentes no rodapé da home.
 [['instagram',75],['youtube',164],['facebook',252],['tiktok',340]].forEach(([k,x])=>add(x,2935,80,90,'Abrir '+k,()=>openExternal(k)));
 // Setas hero: navegação entre os capítulos do site.
 add(25,580,100,150,'Conheça a Bienal',()=>go('a-bienal'));add(1790,580,100,150,'Veja a programação',()=>go('programacao'));
 }
 if(id==='a-casa-movimenta'){
 add(145,2288,570,145,'Ver endereço da Casa Movimenta no mapa',()=>window.open('https://www.google.com/maps/search/?api=1&query=Rua%20dos%20Pacajus%2020%2C%20Praia%20de%20Iracema%2C%20Fortaleza','_blank','noopener,noreferrer'));
 }
 if(id==='informacoes'){
 // CTA de imprensa na faixa branca na parte inferior da página.
 add(75,3687,1000,134,'Acessar materiais para imprensa',()=>openExternal('imprensa'));
 add(73,2120,540,80,'Contato por e-mail',()=>window.open('mailto:contato@bienaldedanca.com'));
 }
}
function scrollAnchor(id,anchor){if(!anchor)return;if(id==='catalogo'&&anchor==='ficha'){const el=document.getElementById('catalog-ficha');el?.scrollIntoView({behavior:'instant'});return}if(id==='informacoes'&&anchor==='ficha'){const rect=$('#canvas').getBoundingClientRect();window.scrollTo({top:window.scrollY+rect.top+rect.height*(535/4605),behavior:'instant'});return}const targetY={formacoes:{oficinas:1000,seminario:1730,percursos:2450,residencias:3175,videocast:3900,danca:4625},programacao:{juazeiro:5800,paracuru:6500,crato:7150,pacatuba:8800,canoa:10000,baturite:10850,guaramiranga:12100},informacoes:{contatos:1750,imprensa:3480}};const y=targetY[id]?.[anchor];if(!y)return;const h=id==='formacoes'?5982:id==='programacao'?13196:id==='informacoes'?4605:1;window.scrollTo({top:Math.round(y/h*$('#canvas').getBoundingClientRect().height),behavior:'instant'})}
function render(){const hash=decodeURIComponent(location.hash.slice(1));let[id,anchor]=hash.split('/');id=aliases[id]||id||'inicio';if(!(id in views))id='inicio';const routeToken=++token;const root=$('#canvas');root.innerHTML=views[id];current=id;enhance(root,id);document.title=(id==='inicio'?'X Bienal Internacional de Dança do Ceará':names[id]+' | X Bienal Internacional de Dança do Ceará');if(!anchor)window.scrollTo({top:0,behavior:'instant'});else requestAnimationFrame(()=>{if(routeToken===token)scrollAnchor(id,anchor)});}
window.addEventListener('hashchange',render);render();
</script></body></html>